#include <iostream>
using namespace std;

#ifndef ElemType
#define ElemType int
#endif

typedef struct LNode{
	ElemType data;
	struct LNode *next;
}LNode, *LinkList;

bool InitList(LinkList *L){
	*L=(LNode*)malloc(sizeof(LNode));
	if(*L==NULL){
		cout << "Init Failed." << endl;
		return false;
	}else{
		(*L)->next=NULL;
		cout << "Init Success." << endl;
		return true;
	}
}

void ShowList(LinkList L){
	LNode *p=L;
	cout << "-----Show List-----" << endl;
	int i=1;
	while(p){
		p=p->next;
		cout << "List[" << i << "] is " << p->data << ". " << endl; 
		i++;
	}
	cout << "--------End--------" << endl;
}

int ListLen(LinkList L){
	LNode *p=L;
	int len=0;
	while(p!=NULL){
		p=p->next;
		len+=1;
	}
	return len;
}

bool InsertList(LinkList *L, int i, ElemType e){
	LNode *p=*L;
	int j=0;
	while(p && j<i-1){
		p=p->next;
		j+=1;
	}
	if (!p && j > i - 1)
		return false;
	LNode *s=(LNode*)malloc(sizeof(LNode));
	if(s==NULL){
		cout << "Malloc Memory Failed." << endl;
		return false;
	}
	s->data=e;
	s->next=p->next;
	p->next=s;
	return true;
}

bool ListDelete(LinkList *L, int i, ElemType e){
	LNode *p=*L;
	int j=0;
	while(p->next && j<i-1){
		p=p->next;
		j+=1;
	}
	if (!(p->next) && j > i - 1)
		return false;
	LNode *s=p->next;
	e=s->data;
	p->next=s->next;
	free(s);	
	return true;
}

int main(){
	cout << "-----Link List-----" << endl;
	LinkList L;
	InitList(&L);
	for(int i=1; i<6; i++){
		if(InsertList(&L, i, i*2+1))
			cout << "Insert " << i*2+1 << " to List[" << i << "] Success." << endl;
	}
	ShowList(L);
	ElemType delValLoc=2;
	ElemType e;
	if(ListDelete(&L, delValLoc, e))
		cout << "Delete " << e << " from List[" << delValLoc << "] Success." << endl;
	else
		cout << "Delete " << e << " from List[" << delValLoc << "] Failed." << endl;
	return 0;
}